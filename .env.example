# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，禁止入库）

# ===== 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_interviewer
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=

# ===== Redis（本机：localhost；跑虚拟机时改成 VM IP）=====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT（生产环境必须更换；长度 >= 32 字节）=====
JWT_SECRET=

# ===== Grafana =====
GRAFANA_ADMIN_PASSWORD=admin

# ===== LLM（阶段 2 启用）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== RAG（阶段 4）=====
EMBEDDING_MODEL=text-embedding-v4
RAG_STORE_PATH=./data/rag-store.json
RESUME_UPLOAD_DIR=./data/uploads
